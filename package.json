{
  "name": "society-manager",
  "version": "1.0.0",
  "description": "Housing Society Management System (offline, data stored on the device)",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Society Manager",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "build:single": "vite build --config vite.single.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/clipboard": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "~22.3.27",
    "electron-builder": "^24.13.3",
    "typescript": "~5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "vite-plugin-singlefile": "^2.0.2"
  },
  "build": {
    "appId": "in.society.manager",
    "productName": "Society Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
